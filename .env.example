# Application
APP_NAME="Enterprise Data Analytics Platform"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# API Configuration
API_HOST="0.0.0.0"
API_PORT=8000
API_PREFIX="/api/v1"
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"

# Database - PostgreSQL (Data Warehouse)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=analytics_db
POSTGRES_USER=analytics_user
POSTGRES_PASSWORD=analytics_pass123
DATABASE_URL=postgresql+asyncpg://analytics_user:analytics_pass123@postgres:5432/analytics_db

# ClickHouse (OLAP Analytics)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_DB=analytics_olap
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_pass123

# Redis (Cache & Session)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis_pass123

# Kafka (Streaming)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PREFIX=analytics
KAFKA_CONSUMER_GROUP=analytics-consumers

# Airflow
AIRFLOW_HOME=/opt/airflow
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__WEBSERVER__SECRET_KEY=your-secret-key-here
AIRFLOW_UID=50000

# S3/MinIO (Data Lake)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=analytics-data-lake
S3_REGION=us-east-1

# Authentication & Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ML & Model Registry
MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_REGISTRY_PATH=/models

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Email (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=analytics@company.com

# External APIs (for data sources)
ALPHA_VANTAGE_API_KEY=your-api-key
NEWS_API_KEY=your-api-key

# Feature Flags
ENABLE_REAL_TIME_PROCESSING=true
ENABLE_ML_PREDICTIONS=true
ENABLE_DATA_QUALITY_CHECKS=true
ENABLE_AUTO_SCALING=false

# Performance
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
CACHE_TTL=3600
QUERY_TIMEOUT=30

# Data Quality
DQ_ALERT_EMAIL=data-team@company.com
DQ_SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Jupyter
JUPYTER_PORT=8888
JUPYTER_TOKEN=analytics123
